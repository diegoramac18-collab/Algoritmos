Algoritmo Circuito1
	//Diego Ramirez Acosta
	
	Definir p, q Como Logico
	
	p <- Verdadero
	q <- Verdadero
	
	Escribir p, "-", q, "-", p y q, "-", no q, "-", (p y q) o (no q)
	
	p <- Verdadero
	q <- Falso
	
	Escribir p, "-", q, "-", p y q, "-", no q, "-", (p y q) o (no q)
	
	p <- Falso
	q <- Verdadero
	
	Escribir p, "-", q, "-", p y q, "-", no q, "-", (p y q) o (no q)
	
	p <- Falso
	q <- Falso
	
	Escribir p, "-", q, "-", p y q, "-", no q, "-", (p y q) o (no q)
	
	
	
FinAlgoritmo
