Algoritmo Circuito2
	//Diego Ramirez Acosta
	
	Definir p, q Como Logico
	
	p <- Verdadero
	q <- Verdadero
	
	Escribir p y q, "-", p, "-", q, "-", (no p) y (no q)
	
	p <- Falso
	q <- Falso
	
	Escribir p y q, "-", p, "-", q, "-", (no p) y (no q)
	
	p <- Verdadero
	q <- falso
	
	Escribir p y q, "-", p, "-", q, "-", (no p) y (no q)
	
	
	
	
FinAlgoritmo