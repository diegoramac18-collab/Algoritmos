Algoritmo P1A4_2
	// Diego Ramirez Acosta
	// Peudocodigo para convertir grados Celsius a grados Kelvin y Fahrenheit.
	Definir C, K, F Como Real
	Escribir "Ingresa grados en Celsius: "
	Leer C
	Escribir "Grados en Farenheit: ", (C * ( 9 / 5 )) + 32
	Escribir "Grados en Kelvin: ", C + 273.15 
FinAlgoritmo
