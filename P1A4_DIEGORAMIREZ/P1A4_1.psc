Algoritmo P1A4_1
	// Diego Ramirez Acosta
	//  Pseudocódigo que lee tres números. Calcula e imprime la suma, el producto y el promedio de estos.
	Definir A, B, C Como Real
	Escribir "Elige el primer numero: "
	Leer A 
	Escribir "Elige el segundo numero: "
	Leer B 
	Escribir "Elige el tercer numero: "
	Leer C 
	
	Escribir "La suma de los numeros es: ", A + B + C
	Escribir "El producto de los numeros es: ", A * B * C
	Escribir "La promedio de los numeros es: ", (A + B + C) / 3
	
FinAlgoritmo
